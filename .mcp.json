{
	"mcpServers": {
		"serena": {
			"command": "uvx",
			"args": [
				"--from",
				"serena-agent==2.1.0",
				"serena",
				"start-mcp-server",
				"--context",
				"claude-code",
				"--project-from-cwd",
				"--open-web-dashboard",
				"false"
			]
		},
		"astro-docs": {
			"type": "http",
			"url": "https://mcp.docs.astro.build/mcp"
		}
	}
}
