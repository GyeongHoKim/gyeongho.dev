---
interface Props {
	src: string;
	poster?: string;
	/** Says what the recording shows, for people who cannot see it. */
	label: string;
}

const { src, poster, label } = Astro.props;
---

<!-- scripts/card-stack.ts plays [data-card-video] only while its card is in front. -->
<video
	data-card-video
	src={src}
	poster={poster}
	muted
	loop
	playsinline
	preload="metadata"
	aria-label={label}
></video>

<style>
video {
	display: block;
	width: 100%;
	height: 100%;
	object-fit: contain;
}
</style>
