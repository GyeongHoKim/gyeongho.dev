<svg
	width="0"
	height="0"
	aria-hidden="true"
	focusable="false"
	class="fisheye-defs"
>
	<filter
		id="fisheye"
		x="0"
		y="0"
		width="100%"
		height="100%"
		color-interpolation-filters="sRGB"
	>
		<feImage
			preserveAspectRatio="none"
			x="0"
			y="0"
			width="100%"
			height="100%"
			result="map"
		></feImage>
		<feDisplacementMap
			in="SourceGraphic"
			in2="map"
			scale="0"
			xChannelSelector="R"
			yChannelSelector="G"
		></feDisplacementMap>
	</filter>
</svg>

<style>
.fisheye-defs {
	position: absolute;
}
</style>
