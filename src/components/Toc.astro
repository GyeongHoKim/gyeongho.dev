---
import type { MarkdownHeading } from "astro";
import { type Locale, t } from "../i18n";

interface Props {
	headings: MarkdownHeading[];
	locale: Locale;
}

const { headings, locale } = Astro.props;

interface Entry {
	heading: MarkdownHeading;
	children: MarkdownHeading[];
}

// The h2 headings are the numbered entries. An h3 goes under the entry before
// it, so that it does not take a number; before the first h2 it is an entry.
const entries: Entry[] = [];
for (const heading of headings) {
	if (heading.depth > 3) continue;
	const parent = entries.at(-1);
	if (heading.depth === 3 && parent) parent.children.push(heading);
	else entries.push({ heading, children: [] });
}
---

{entries.length > 0 && (
	<gh-card variant="lined" fastener="pin" tilt="right">
		<div class="toc">
			<h2 class="hand">{t(locale, "post.toc")}</h2>
			<ol>
				{entries.map(({ heading, children }) => (
					<li>
						<a href={`#${heading.slug}`}>{heading.text}</a>
						{children.length > 0 && (
							<ul>
								{children.map((child) => (
									<li>
										<a href={`#${child.slug}`}>{child.text}</a>
									</li>
								))}
							</ul>
						)}
					</li>
				))}
			</ol>
		</div>
	</gh-card>
)}

<style>
gh-card {
	display: block;
}
.toc {
	padding-left: var(--sys-spacing-xl);
}
h2 {
	margin: 0;
	font-size: var(--sys-typography-title-fontSize);
	line-height: 28px;
}
ol {
	margin: 0;
	padding-left: var(--sys-spacing-lg);
	font-size: var(--sys-typography-label-fontSize);
	line-height: 28px;
}
ul {
	margin: 0;
	padding-left: var(--sys-spacing-md);
	list-style-type: circle;
}
a {
	display: inline-block;
	min-height: 28px;
}
</style>
