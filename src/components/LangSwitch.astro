---
import { LOCALES, type Locale, localePath, switchLocalePath, t } from "../i18n";

interface Props {
	locale: Locale;
	/** Locales the current page exists in; others link to their blog index. */
	alternates?: readonly Locale[];
}

const { locale, alternates = LOCALES } = Astro.props;
const names: Record<Locale, string> = { ko: "한국어", en: "English" };
---

<nav class="lang-switch" aria-label={t(locale, "footer.language")}>
	{LOCALES.map((code, index) => (
		<>
			{index > 0 && <span aria-hidden="true">·</span>}
			{code === locale ? (
				<span aria-current="true" lang={code}>
					{names[code]}
				</span>
			) : (
				<a
					href={
						alternates.includes(code)
							? switchLocalePath(Astro.url.pathname, code)
							: localePath(code, "blog")
					}
					hreflang={code}
					lang={code}
				>
					{names[code]}
				</a>
			)}
		</>
	))}
</nav>

<style>
.lang-switch {
	display: flex;
	align-items: center;
	gap: var(--sys-spacing-sm);
	font-size: var(--sys-typography-label-fontSize);
	color: var(--sys-color-text-secondary);
}
.lang-switch a,
.lang-switch span[aria-current] {
	min-height: 44px;
	display: inline-flex;
	align-items: center;
}
.lang-switch span[aria-current] {
	color: var(--sys-color-text-primary);
	font-weight: 700;
}
</style>
