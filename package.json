{
	"name": "gyeongho.dev",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"typecheck": "tsc --noEmit",
		"test": "npm run test:desktop && npm run test:mobile",
		"test:desktop": "web-test-runner --config web-test-runner.desktop.config.mjs",
		"test:mobile": "web-test-runner --config web-test-runner.mobile.config.mjs",
		"lit-localize:extract": "lit-localize extract",
		"lit-localize:build": "lit-localize build"
	},
	"dependencies": {
		"@lit/localize": "^0.10.0",
		"@ficusjs/router": "^3.0.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"iconify-icon": "^3.0.2",
		"lit": "^3.3.1",
		"marked": "^15.0.0",
		"three": "^0.170.0",
		"zustand": "^5.0.11"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"@esm-bundle/chai": "^4.3.4-fix.0",
		"@lit/localize-tools": "^0.8.1",
		"@types/three": "^0.170.0",
		"@web/test-runner": "^0.19.0",
		"@web/test-runner-puppeteer": "*",
		"@web/dev-server-esbuild": "*",
		"typescript": "~5.9.3",
		"vite": "^7.2.4"
	}
}
